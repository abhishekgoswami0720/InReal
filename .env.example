# Copy this file to .env (never commit .env) and fill in the values.

# Azure OpenAI. Two resources are fine: one for embeddings, one for the gpt-4o judge.
# Paste the RESOURCE url (https://NAME.openai.azure.com/) and KEY 1 from "Keys and Endpoint".
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://YOUR-EMBED-RESOURCE.openai.azure.com/
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_GPT4O_ENDPOINT=https://YOUR-GPT4O-RESOURCE.openai.azure.com/
AZURE_OPENAI_GPT4O_KEY=
# Only if your deployments are NOT named text-embedding-3-small / gpt-4o:
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
# Set to gemini to embed with Gemini instead (default is azure when the endpoint above is set)
# EMBED_PROVIDER=azure

# Gemini API key from https://aistudio.google.com/apikey. Only needed with EMBED_PROVIDER=gemini
GEMINI_API_KEY=

# (Not named N8N_..., because n8n reads N8N_* variables itself when its terminal loads this file.)
# n8n webhook that starts the scam-moderation workflow after every scrape from the dashboard.
# Leave empty to rely on the workflow's 30-minute schedule instead.
INREAL_N8N_WEBHOOK=http://localhost:5678/webhook/inreal-moderate

# Optional: lets a remote caller change data (header X-InReal-Token). Leave empty for laptop-only writes.
INREAL_ADMIN_TOKEN=
