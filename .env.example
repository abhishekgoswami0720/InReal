# Copy this file to .env (never commit .env) and fill in the values.

# Gemini API key from https://aistudio.google.com/apikey
# Used by: python -m moderation.build_index  (the n8n workflow keeps its own copy as a credential)
GEMINI_API_KEY=

# (Not named N8N_..., because n8n reads N8N_* variables itself when its terminal loads this file.)
# n8n webhook that starts the scam-moderation workflow after every scrape from the dashboard.
# Leave empty to rely on the workflow's 30-minute schedule instead.
INREAL_N8N_WEBHOOK=http://localhost:5678/webhook/inreal-moderate

# Optional: lets a remote caller change data (header X-InReal-Token). Leave empty for laptop-only writes.
INREAL_ADMIN_TOKEN=
