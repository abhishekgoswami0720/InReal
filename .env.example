# Copy this file to .env (never commit .env) and fill in the values.

# Azure OpenAI. Two resources are fine: one for embeddings, one for the gpt-4o judge.
# Paste the RESOURCE url (https://NAME.openai.azure.com/) and KEY 1 from "Keys and Endpoint".
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://YOUR-EMBED-RESOURCE.openai.azure.com/
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_GPT4O_ENDPOINT=https://YOUR-GPT4O-RESOURCE.openai.azure.com/
AZURE_OPENAI_GPT4O_KEY=
# Only if your deployments are NOT named text-embedding-3-small / gpt-4o:
# AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
# Set to gemini to embed with Gemini instead (default is azure when the endpoint above is set)
# EMBED_PROVIDER=azure

# Gemini API key from https://aistudio.google.com/apikey. Only needed with EMBED_PROVIDER=gemini
GEMINI_API_KEY=

# Scam check: "python" (default) runs it inside the app, no n8n needed (moderation/pipeline).
# "n8n" uses the old n8n workflow through INREAL_N8N_WEBHOOK instead.
SCAM_CHECK=python
# Second look by an AI agent at "needs a look" posts (company site, apply link, web search). on / off
MOD_AGENT=on
# Optional knobs (defaults shown): risk for "likely scam" / "needs a look", posts per round,
# posts per AI call, AI calls at once
# MOD_BLOCK_AT=0.7
# MOD_REVIEW_AT=0.4
# MOD_BATCH_LIMIT=10
# MOD_JUDGE_BATCH=5
# MOD_JUDGE_PARALLEL=2

# Only with SCAM_CHECK=n8n. (Not named N8N_..., because n8n reads N8N_* variables itself.)
INREAL_N8N_WEBHOOK=

# Optional: lets a remote caller change data (header X-InReal-Token). Leave empty for laptop-only writes.
INREAL_ADMIN_TOKEN=
# Extra host names allowed to reach the app directly (comma separated), only for a LAN setup.
# Left empty, only localhost / 127.0.0.1 work, which blocks DNS-rebinding attacks from websites.
INREAL_ALLOWED_HOSTS=

# --- Supabase (users, Google login, the shared internship list) ---
# URL and publishable key are public (they go to the browser).
SUPABASE_URL=https://fljxkwcenjcfsrcrtpmk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_3OtMYP-wbKPCki2OzU9FZQ_Ju1tQfnG
# SECRET: Supabase dashboard > Project Settings > API Keys > Secret keys. Laptop only, never in the browser or git.
SUPABASE_SECRET_KEY=

# --- Automatic update (autopilot.py) ---
# NOT USED: since 20 Oct 2026 app.py never starts it, whatever these say. Sites are scraped only when
# someone presses Search Internships, and only the sites they pick. Kept for a later server setup.
AUTO_UPDATE=off
AUTO_EVERY_HOURS=6
# comma-separated field keys: ai_ml, software, data, medical, pharma_bio, core_eng, finance, marketing, design, content, hr_ops, law
AUTO_FIELDS=software
AUTO_LIMIT=120
